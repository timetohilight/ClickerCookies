<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#291F4F"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/topHud2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/usernameViewLvl2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Профиль: Загрузка..."
                android:textColor="#B3A9E6"
                android:textSize="14sp"
                android:textStyle="normal"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/cookieViewLvl2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LVL 2: 0 🍪"
                android:textColor="#E9E6FF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoToLeaderboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/button_style_lvl2"
            android:text="РЕКОРДЫ"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mainCookieLvl2"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/blue_cookie"
        app:layout_constraintTop_toBottomOf="@id/topHud2"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationLvl2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavigationLvl2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToLvl1"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"
            android:background="@drawable/button_style_lvl2"
            android:text="1 УРОВЕНЬ"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShopLvl2"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:background="@drawable/button_style_lvl2"
            android:text="МАГАЗИН 2"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>