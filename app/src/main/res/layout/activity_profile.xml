<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_gradient">

    <!-- Текущий выбранный аккаунт -->
    <TextView
        android:id="@+id/tvCurrentProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Текущий профиль: "
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"/>

    <!-- Поле ввода для создания нового игрока -->
    <EditText
        android:id="@+id/etNewUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Имя нового игрока"
        android:textColorHint="#99FFFFFF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <!-- Список всех профилей -->
    <ListView
        android:id="@+id/lvProfiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#33FFFFFF"
        android:layout_marginBottom="15dp" />

    <!-- Кнопки управления -->
    <Button
        android:id="@+id/btnCreateProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_style"
        android:text="Выбрать / Создать профиль"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnDeleteProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_style"
        android:text="Удалить выбранный"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_style"
        android:text="Назад"
        android:textColor="#FFFFFF"/>

</LinearLayout>